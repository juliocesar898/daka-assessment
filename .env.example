# ============================================================
# Daka Technical Assessment — Variables de Entorno
# Copia este archivo: cp .env.example .env
# ⚠️  NUNCA subas .env a git. Está en .gitignore.
# ============================================================

# ─── Base de Datos (PostgreSQL) ──────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=technical-test
DATABASE_PASSWORD=technical-test-pass
DATABASE_NAME=technical-test_db

# ─── Autenticación JWT ──────────────────────────────────────
# ⚠️  OWASP A02: Usa un secret de al menos 32 caracteres aleatorios
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-secret-min-32-chars

# ─── Node.js ─────────────────────────────────────────────────
NODE_ENV=development

